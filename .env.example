# --- Upstox app (https://account.upstox.com/developer/apps) ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/callback

# --- Access token storage: ssm | file | env ---
TOKEN_SOURCE=ssm
TOKEN_SSM_PARAM=/range-breakout/upstox_access_token
TOKEN_FILE=.upstox_token
AWS_REGION=ap-south-1
# only used when TOKEN_SOURCE=env
UPSTOX_ACCESS_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Indices to watch (Upstox instrument keys, comma separated) ---
INDICES=NSE_INDEX|Nifty 50,NSE_INDEX|Nifty Bank,BSE_INDEX|SENSEX

# --- Tight range detection ---
CANDLE_MINUTES=15
# a range is at least MIN and at most MAX candles (1h to 3h on 15m)
MIN_RANGE_CANDLES=4
MAX_RANGE_CANDLES=12
# the whole range must fit inside RANGE_ATR_MULT x ATR(ATR_PERIOD) of the candles before it
ATR_PERIOD=14
RANGE_ATR_MULT=1.5
# optional hard cap on range width as % of price (0 = off)
MAX_RANGE_PCT=0

# --- Breakout alerts ---
# ltp = alert the moment price crosses the range; close = wait for a 15m close beyond it
BREAKOUT_ON=ltp
BREAKOUT_BUFFER_PCT=0.02
# scalp target = range width x TARGET_MULT from entry; stop = other side of the range
TARGET_MULT=1.0
LAST_ALERT_TIME=15:00
