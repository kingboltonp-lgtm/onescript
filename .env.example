# Copy to .env and replace every YOUR_* value with a real secret. Never commit .env.
# YOUR_TELEGRAM_BOT_TOKEN is a placeholder. A real token looks like 123456789:AAH...

TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

UPSTOX_API_KEY=YOUR_API_KEY
UPSTOX_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# Optional: heartbeat interval in seconds (default 3600)
# HEARTBEAT_INTERVAL_SECONDS=3600

# Optional: main loop sleep in seconds (default 5)
# LOOP_INTERVAL_SECONDS=5
