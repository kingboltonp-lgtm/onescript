# --- Upstox app (https://account.upstox.com/developer/apps) ---
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/callback

# --- Access token storage: ssm | file | env ---
TOKEN_SOURCE=ssm
TOKEN_SSM_PARAM=/range-breakout/upstox_access_token
TOKEN_FILE=.upstox_token
AWS_REGION=ap-south-1
# only used when TOKEN_SOURCE=env
UPSTOX_ACCESS_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Instruments ---
# Candles are read from SIGNAL_INSTRUMENT; orders go to TRADE_INSTRUMENT.
SIGNAL_INSTRUMENT=NSE_INDEX|Nifty 50
TRADE_INSTRUMENT=
LOT_SIZE=75

# --- Strategy ---
CANDLE_MINUTES=15
REWARD_RISK=2.0
MAX_TRADES_PER_DAY=1
LAST_ENTRY_TIME=14:30
SQUARE_OFF_TIME=15:15
# skip the day if the opening range is wider than this % of price (0 = off)
MAX_RANGE_PCT=0

# --- Risk ---
RISK_PER_TRADE=7500
MAX_LOTS=1

# --- Safety: nothing is sent to the exchange unless this is true ---
LIVE_TRADING=false
